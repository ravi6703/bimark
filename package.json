{
  "name": "bimark",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Brand Visibility Engine — Board Infinity Presence (PRD v0.2). A repurpose-owned-material-into-distinctive-social-presence intelligence layer.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --import tsx src/index.ts",
    "dev": "node --import tsx --watch src/index.ts",
    "migrate": "node --import tsx src/db/migrate.ts",
    "seed": "node --import tsx src/db/seed.ts",
    "ingest": "node --import tsx src/cli/ingest.ts",
    "pitch": "node --import tsx src/cli/pitch.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
