# ─────────────────────────────────────────────────────────────────────────────
# Brand Visibility Engine — environment configuration
# Copy to `.env` and fill in. Every external integration degrades to a safe
# mock when its credentials are absent, so the app boots and tests pass with an
# empty file. Add credentials to light up each real integration.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Postgres (pgvector) ---
# If unset, DB-backed workflows are skipped; pure-logic tests still run.
DATABASE_URL=postgres://bimark:bimark@localhost:5432/bimark

# --- LLM (Anthropic Claude) ---
# Without a key, the deterministic MockLLM is used (drafts are stubbed but the
# whole pipeline runs end to end). See src/llm/router.ts for model routing (§20).
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-4-5-20251001
LLM_MODEL_STRONG=claude-opus-4-8
# Reviewer + final polish run on the strong tier; pitch + first draft on fast.

# --- Embeddings (§18) ---
# EMBED_PROVIDER: mock | openai | voyage
# `mock` is deterministic + offline (good for dev/CI). The HTTP providers need a key.
EMBED_PROVIDER=mock
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
EMBED_API_KEY=
EMBED_BASE_URL=https://api.openai.com/v1

# --- Telegram (approval gate, §9) ---
# Without a token, approvals auto-resolve in the log (dev) instead of prompting.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SECOND_APPROVER_CHAT_ID=

# --- Publishing (§8 buy-the-plumbing) ---
# PUBLISH_PROVIDER: mock | buffer | ayrshare
PUBLISH_PROVIDER=mock
BUFFER_ACCESS_TOKEN=
BUFFER_PROFILE_ID_LINKEDIN=
AYRSHARE_API_KEY=

# --- Image generation (§20) — Instagram drafts need media; auto-generated + self-hosted ---
# IMAGE_PROVIDER: mock | openrouter | openai
IMAGE_PROVIDER=openrouter
IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_API_KEY=
OPENAI_API_KEY=
IMAGE_SIZE=1024x1024
# Own origin, so Ayrshare/the dashboard can fetch generated images back from us.
# Auto-detected on Vercel (VERCEL_PROJECT_PRODUCTION_URL); set explicitly elsewhere.
PUBLIC_BASE_URL=

# --- Scheduling (§16) ---
# Cron expressions in server timezone. Defaults: pitch 08:00 IST, poll 30m, sov weekly, memo monthly.
TZ=Asia/Kolkata
CRON_MORNING_PITCH=0 8 * * *
CRON_ANALYTICS_POLL=*/30 * * * *
CRON_SOV=0 9 * * 1
CRON_EDITORIAL_MEMO=0 9 1 * *
CRON_INGEST_REFRESH=0 2 * * *

# --- RAG thresholds (§4.2 / §18) ---
# Below this cosine similarity, drafts are flagged `low_source` rather than inventing claims.
RAG_SIMILARITY_THRESHOLD=0.35
RAG_TOP_K=6

# --- Quality gate (§7) ---
FIRST_PASS_APPROVAL_TARGET=0.70
